<UserControl
    x:Class="D2RCompanion.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:D2RCompanion.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="8"
            HorizontalAlignment="Center"
            Background="#131415"
            BorderBrush="Black"
            BorderThickness="1">

            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Image
                    Width="48"
                    Height="48"
                    Source="/Resources/1.ico" />
                <Button
                    Width="48"
                    Height="48"
                    Margin="8,0,0,0"
                    Command="{Binding ShowSettingsCommand}"
                    Content="&#xE713;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="32" />
                <Button
                    Width="48"
                    Height="48"
                    Margin="4,0,0,0"
                    Content="&#xE721;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="32" />
                <Button
                    Width="48"
                    Height="48"
                    Margin="4,0,0,0"
                    Command="{Binding ShowTraderieCommand}"
                    Content="Traderie" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
